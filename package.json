{
  "name": "memeloop-agent-ui",
  "private": true,
  "description": "Responsive MemeLoop Agent chat UI for TiddlyWiki and TidGi Desktop",
  "url": "https://tiddly-gittly.github.io/Modern.TiddlyDev/",
  "license": "MIT",
  "version": "0.1.0",
  "scripts": {
    "dev": "tiddlywiki-plugin-dev dev",
    "dev:wiki": "tiddlywiki-plugin-dev dev --write-wiki",
    "test": "vitest run",
    "test:tw": "tiddlywiki-plugin-dev test",
    "build": "npm run clean && tiddlywiki-plugin-dev build && npm run check:artifact",
    "publish": "npm run clean && tiddlywiki-plugin-dev publish",
    "reset": "rimraf ./**/node_modules",
    "clean": "rimraf dist",
    "prepare": "husky",
    "update": "npm-check-updates -u && dprint config update",
    "new": "tiddlywiki-plugin-dev new",
    "build:library": "npm run clean && tiddlywiki-plugin-dev build --library --output dist/library",
    "publish:offline": "npm run clean && tiddlywiki-plugin-dev publish --offline",
    "dev:lan": "tiddlywiki-plugin-dev dev --lan",
    "test:playwright": "playwright test",
    "test:playwright:headed": "playwright test --headed",
    "test:playwright:debug": "playwright test --debug",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "lint": "eslint ./src --ext js,ts,tsx,json",
    "lint:fix": "eslint ./src --ext ts,tsx,json --fix",
    "check": "tsc --noEmit --skipLibCheck",
    "check:artifact": "node scripts/check-components-artifact.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "husky": {
    "hooks": {
      "pre-commit": "lint-staged"
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "node --max_old_space_size=8192 ./node_modules/eslint/bin/eslint.js --fix --color --cache --quiet"
    ],
    "*.{js,jsx,mjs,mjsx,cjs,cjsx}": [
      "node --max_old_space_size=8192 ./node_modules/eslint/bin/eslint.js --fix --color --cache --quiet"
    ]
  },
  "devDependencies": {
    "@modern-js/tsconfig": "^3.1.3",
    "@types/node": "^25.6.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "dprint": "^0.54.0",
    "eslint": "^9.39.1",
    "eslint-config-tidgi": "^2.2.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "jsdom": "29.1.1",
    "rimraf": "^6.1.3",
    "tw5-typed": "^1.1.5",
    "typescript": "^6.0.2",
    "@playwright/test": "^1.59.1",
    "@types/jasmine": "^6.0.0",
    "vitest": "4.1.10"
  },
  "dependencies": {
    "@assistant-ui/core": "0.3.17",
    "@assistant-ui/react": "0.15.16",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "@memeloop/react-ui": "^0.2.2",
    "@mui/icons-material": "^9.2.0",
    "@mui/material": "^9.2.0",
    "@rjsf/core": "6.7.0",
    "@rjsf/mui": "6.7.0",
    "@rjsf/utils": "6.7.0",
    "@rjsf/validator-ajv8": "6.7.0",
    "i18next": "26.3.6",
    "material-ui-cron": "2.0.1",
    "memeloop": "^0.3.1",
    "npm-check-updates": "^20.0.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tiddlywiki": "^5.3.8",
    "tiddlywiki-plugin-dev": "^0.5.7",
    "tw-react": "0.6.4"
  }
}
